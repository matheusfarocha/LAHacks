# Glass Car Dash backend config. Copy to .env and edit:
#   cp .env.example .env

# Must be the exact same string as the VITE_API_KEY baked into the .ehpk
# you install (see README step 5/7). Not a secret — it exists to force a
# CORS preflight so a random webpage can't fire media commands.
REMOTE_KEY=change-me

# Defaults shown. HOST stays on loopback on the phone; set HOST=0.0.0.0
# only for the dev loop, where vite's proxy reaches the phone over Wi-Fi.
# PORT=8790
# HOST=127.0.0.1

# Opt-in drive logging to ~/glass-car-dash-debug.log (writes location data).
# DEBUG_LOG=1
